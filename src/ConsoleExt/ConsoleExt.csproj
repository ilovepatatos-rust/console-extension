<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>

        <RootNamespace>Oxide.Ext.ConsoleExt</RootNamespace>
        <AssemblyName Condition="'$(RustFramework)' == 'carbon'">Carbon.Ext.ConsoleExt</AssemblyName>
        <AssemblyName Condition="'$(RustFramework)' != 'carbon'">Oxide.Ext.ConsoleExt</AssemblyName>

        <!-- Removes the .pdb file from the output folder. -->
        <DebugType>embedded</DebugType>
    </PropertyGroup>
</Project>
