<Project>
    <!--
      Resolve game/framework assemblies from src/dependencies/{channel}/{os}/{framework}
      the same way RustProxyPlugins does: AssemblySearchPaths + named references (no HintPath).
    -->
    <PropertyGroup>
        <AssemblySearchPaths>$(DependencyDirectory);$(AssemblySearchPaths)</AssemblySearchPaths>
    </PropertyGroup>
    <PropertyGroup Condition="'$(RustFramework)' == 'oxide+carbon'">
        <AssemblySearchPaths>$(OxideDependencyDirectory);$(CarbonDependencyDirectory);$(AssemblySearchPaths)</AssemblySearchPaths>
    </PropertyGroup>

